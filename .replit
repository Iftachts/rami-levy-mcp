run = "npm run start:remote"
entrypoint = "src/remote.ts"
modules = ["nodejs-20"]

[build]
command = "npm install && npm run build"

[[ports]]
localPort = 3000
externalPort = 3000

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MCP Server"

[[workflows.workflow]]
name = "MCP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start:remote"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
